DATABASE_URL="postgresql://user:password@localhost:5432/eyano?schema=public"
AUTH_SECRET="change-this-to-a-secure-random-string"
FRONTEND_URL="http://localhost:3000"
PORT=3001

GEMINI_API_KEY=""
OPENAI_API_KEY=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Kepler Image (experimental) : generation d images. Coupe par defaut ;
# seule la valeur exacte true l active (sinon /api/image/generate n existe pas).
KEPLER_IMAGE_ENABLED=false
# Retouche d'images (image precedente, photo envoyee) : coupee par defaut (couts)
KEPLER_IMAGE_EDIT_ENABLED=false
# Backend des images : vide = Gemini (facturation requise) ; pollinations ; cloudflare (quota gratuit quotidien)
KEPLER_IMAGE_BACKEND=
# Cle Pollinations (enter.pollinations.ai), requise si KEPLER_IMAGE_BACKEND=pollinations
POLLINATIONS_API_KEY=
# Modele de creation Pollinations (vide = z-image). Moins cher : sana ; compromis : flux
KEPLER_POLLINATIONS_MODEL=
# Cloudflare Workers AI (si KEPLER_IMAGE_BACKEND=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Identifiants supplementaires (bascule automatique quand un quota du jour est epuise)
# CLOUDFLARE_ACCOUNT_ID_1=
# CLOUDFLARE_API_TOKEN_1=
# CLOUDFLARE_ACCOUNT_ID_2=
# CLOUDFLARE_API_TOKEN_2=
# Modele Cloudflare (vide = SDXL Lightning, gratuit en beta ; ex. @cf/black-forest-labs/flux-1-schnell)
KEPLER_CLOUDFLARE_MODEL=
