# ============================================================
# Eyano - Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=eyano
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=eyano

# --- API ---
DATABASE_URL=postgresql://eyano:CHANGE_ME_STRONG_PASSWORD@postgres:5432/eyano?schema=public
AUTH_SECRET=CHANGE_ME_TO_RANDOM_64_CHARS
FRONTEND_URL=https://example.com
PORT=3001

# --- Admin ---
ADMIN_API_KEY=CHANGE_ME_TO_SECURE_RANDOM_STRING

# --- Gemini AI Keys (key rotation) ---
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_COOLDOWN_MS=60000

# --- OpenAI (optional) ---
OPENAI_API_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# --- Apple OAuth (optional) ---
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=https://api.example.com/api/auth/apple/callback

# --- Storage / S3 (optional) ---
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_APP_NAME=Eyano

# Kepler Image (experimental) : generation d'images dans le chat. Coupe par
# defaut ; seule la valeur exacte true l'active (cote API uniquement).
KEPLER_IMAGE_ENABLED=false
# Retouche d'images (image precedente, photo envoyee) : coupee par defaut (couts)
KEPLER_IMAGE_EDIT_ENABLED=false
# Backend des images : vide = Gemini (facturation requise) ; pollinations ; cloudflare (quota gratuit quotidien)
KEPLER_IMAGE_BACKEND=
# Cle Pollinations (enter.pollinations.ai), requise si KEPLER_IMAGE_BACKEND=pollinations
POLLINATIONS_API_KEY=
# Modele de creation Pollinations (vide = z-image). Moins cher : sana ; compromis : flux
KEPLER_POLLINATIONS_MODEL=
# Cloudflare Workers AI (si KEPLER_IMAGE_BACKEND=cloudflare)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Identifiants supplementaires (bascule automatique quand un quota du jour est epuise)
# CLOUDFLARE_ACCOUNT_ID_1=
# CLOUDFLARE_API_TOKEN_1=
# CLOUDFLARE_ACCOUNT_ID_2=
# CLOUDFLARE_API_TOKEN_2=
# Modele Cloudflare (vide = SDXL Lightning, gratuit en beta ; ex. @cf/black-forest-labs/flux-1-schnell)
KEPLER_CLOUDFLARE_MODEL=

# --- Domain (for Caddy HTTPS) ---
DOMAIN=example.com
API_DOMAIN=api.example.com
